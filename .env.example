# TrikRide environment configuration
#
# Copy this file to `.env` in the project root and fill in the real values.
# `.env` is gitignored, so secrets never reach the repository.
#
#   cp .env.example .env
#
# After editing `.env`, run File > Sync Project with Gradle Files in
# Android Studio so the new values are picked up.

# Google Maps SDK for Android key (Google Cloud Console).
# Injected into AndroidManifest.xml at build time.
MAPS_API_KEY=

# Support contact shown on the in-app Support screen.
SUPPORT_HOTLINE=0966-749-7561
SUPPORT_EMAIL=trikride@tpc.edu.ph

# Optional: overrides the Realtime Database URL that google-services.json
# provides. Leave blank unless Firebase support tells you otherwise.
FIREBASE_DB_URL=

# ---------------------------------------------------------------------------
# Release signing
# ---------------------------------------------------------------------------
# Needed only to build a distributable release. Leave blank for debug builds:
# the release build then falls back to the debug key and Gradle prints a
# warning saying the output must not be handed out.
#
# Generate a keystore once, from the project root:
#
#   keytool -genkeypair -v \
#     -keystore trikride-release.jks \
#     -alias trikride \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then back the .jks file up somewhere that is not this laptop. If it is lost,
# nobody who installed the app can ever be sent an update: the only way out is
# a new package name and a fresh install for every user.

# Path to the keystore. Relative paths resolve from the project root.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=trikride
RELEASE_KEY_PASSWORD=
